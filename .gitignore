.DS_Store
Thumbs.db
*.swp
*.swo
*~
.test-output/
.task/
node_modules/
.lola/
.review-council/
*.log
.claude/handoff/
.superpowers/
.venv/

# Working artifacts — specs and plans (never committed)
docs/superpowers/

# MegaLinter run artifacts (REPORT_OUTPUT_FOLDER, default megalinter-reports/).
# Keeps file-level linters off them via IGNORE_GITIGNORED_FILES, which defaults
# to true. The repository-descriptor linters run with cli_lint_mode: project and
# walk the tree themselves, so each needs its own exclusion — see
# .secretlintignore, .trufflehog-exclude-paths.txt, trivy.yaml, and the devskim
# and jscpd arguments in .mega-linter.local.yml.
megalinter-reports/

# lola-eval runtime artifacts
.lola-eval/runs.db
.lola-eval/workspace/
.lola-eval/transcripts/
.lola-eval/reports/
.lola-eval/last-run.json
.lola-eval/junit.xml


# lola-eval provisioned artifacts (regenerated by provision.sh)
.lola-eval/tests/*/starter/.lola/
.lola-eval/tests/*/starter/.claude/
.lola-eval/tests/*/starter/.opencode/
.lola-eval/tests/*/starter/.gitconfig
.lola-eval/tests/*/starter/AGENTS.md
.lola-eval/tests/*/starter/CLAUDE.md
.lola-eval/tests/*/starter-clean/
.lola-eval/out/
.claude/

# lola-generated assistant instructions (regenerated by `lola update`)
/CLAUDE.md
