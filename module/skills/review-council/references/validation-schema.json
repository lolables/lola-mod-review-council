{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation gate outcomes",
  "description": "Written verbatim by the orchestrator from the validator's reply to verdicts/_meta/validation.json and applied by rc-apply-validation.sh.",
  "type": "object",
  "required": ["results"],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "result", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "file": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["CONFIRMED", "CORRECTED", "RETRACTED"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" },
          "corrections": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "line": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000000 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "recommendation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
