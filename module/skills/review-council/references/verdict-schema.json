{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Council reviewer verdict",
  "type": "object",
  "required": ["agent", "files_read", "verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "agent": { "type": "string", "minLength": 1 },
    "files_read": { "type": "array", "items": { "type": "string" } },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST CHANGES"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "evidence", "description", "recommendation"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000000 },
          "evidence": { "type": "string", "minLength": 1 },
          "constraint": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
